{
	"compilerOptions": {
		"target": "ES2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ES2024"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build", "dist"]
}
